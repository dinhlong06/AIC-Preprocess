# API keys cho layer_3/OCR_gemma/gemma_ocr.py — copy thành .env rồi điền giá trị thật.
# KHÔNG commit file .env (chỉ .env.example này được track).
# run_caption_batch1.sh đọc key từ ../../retrieval_system/.env (repo bên cạnh),
# chạy gemma_ocr.py trực tiếp thì export các biến dưới đây.

# Google AI Studio (model ais26/ais31) — key chính + key phụ cho shard song song
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# UIT endpoint (model gemma/qwen) — Bearer token
LLM_API_KEY=

# Base URL — chỉ đặt khi đổi endpoint, trống = mặc định trong code
#UIT_BASE_URL=https://llm.uit.edu.vn
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/{}:generateContent

# CA bundle cho TLS của UIT endpoint (tuỳ chọn — trống = trust store hệ thống)
UIT_CA_BUNDLE=

# Tuỳ chọn (có mặc định trong code)
GEMMA_WORKERS=20
AIS_RPM=20
